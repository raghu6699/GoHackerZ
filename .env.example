# ── Database (Supabase Postgres) ─────────────────────────────
# Supabase Dashboard → Project Settings → Database → Connection string (URI)
# Use the "Connection pooling" string for serverless/Vercel (port 6543).
# NEVER commit real credentials — this file must contain placeholders only.
DATABASE_URL="postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"

# Optional: dedicated DB for integration tests. Tests SKIP if unset.
TEST_DATABASE_URL="postgresql://postgres:YOUR_DB_PASSWORD@localhost:5432/gohackerz_test"

# ── Supabase Auth / Storage ──────────────────────────────────
# Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_ANON_KEY"

# Service role key — SERVER ONLY, never expose to the browser.
# Used for admin operations (seeding topics, role management).
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"

# ── Site ─────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://gohackerz.com

# ── Email (optional — console transport used when unset) ─────
# Resend API key enables real newsletter confirmation/welcome emails.
RESEND_API_KEY=""
MAIL_FROM="GoHackerz <hello@yourdomain.com>"

# ── Analytics cron ───────────────────────────────────────────
# Protects /api/cron/analytics-rollup. Vercel Cron sends it as
# `Authorization: Bearer $CRON_SECRET` automatically. Required in production.
CRON_SECRET=""

# Optional extra salt for analytics session hashing (falls back to CRON_SECRET
# or DATABASE_URL when unset).
ANALYTICS_SALT=""